#!/bin/bash
#SBATCH --job-name=sam-football
#SBATCH --partition=MGPU-TC2
#SBATCH --qos=normal
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=10
#SBATCH --mem=30G
#SBATCH --time=02:00:00
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

set -euo pipefail

JOB_DIR="$1"
REMOTE_ROOT="$(dirname "$(dirname "$(dirname "$JOB_DIR")")")"
RUNTIME_DIR="${SAM2_RUNTIME_DIR:-$REMOTE_ROOT/runtime}"
exec >"$JOB_DIR/job.log" 2>&1

module load anaconda/25.5.1 cuda/12.8.0
export SAM2_CHECKPOINT="${SAM2_CHECKPOINT:-$RUNTIME_DIR/checkpoints/sam2.1_hiera_base_plus.pt}"
export SAM2_MODEL_CONFIG="${SAM2_MODEL_CONFIG:-configs/sam2.1/sam2.1_hiera_b+.yaml}"
export GENERIC_DETECTOR_MODEL="${GENERIC_DETECTOR_MODEL:-$RUNTIME_DIR/checkpoints/yolo11s-seg.pt}"
export GENERIC_DETECTOR_ENABLED="${GENERIC_DETECTOR_ENABLED:-true}"
export GENERIC_DETECTOR_FALLBACK_MEDIAN="${GENERIC_DETECTOR_FALLBACK_MEDIAN:-18}"
export GENERIC_DETECTOR_IMGSZ="${GENERIC_DETECTOR_IMGSZ:-1280}"
export GENERIC_DETECTOR_CONF="${GENERIC_DETECTOR_CONF:-0.08}"
export GENERIC_TRACK_NEW_CONFIDENCE="${GENERIC_TRACK_NEW_CONFIDENCE:-0.25}"
export SAM_MODEL_TIER="${SAM_MODEL_TIER:-base_plus}"
export PYTHONPATH="$JOB_DIR:$RUNTIME_DIR/sam2"
export TORCH_HOME="$RUNTIME_DIR/torch-cache"
export EASYOCR_MODULE_PATH="$RUNTIME_DIR/easyocr"
export TRITON_CACHE_DIR="$RUNTIME_DIR/triton-cache"
export TORCHINDUCTOR_CACHE_DIR="$RUNTIME_DIR/torchinductor-cache"
export PYTHONUNBUFFERED=1
export GSR_RUNTIME_DIR="${GSR_RUNTIME_DIR:-$REMOTE_ROOT/gsr-runtime}"
export PITCHVISION_CORES="${SLURM_CPUS_PER_TASK:-10}"
export XDG_CACHE_HOME="$GSR_RUNTIME_DIR/cache"
export MPLCONFIGDIR="$GSR_RUNTIME_DIR/cache/matplotlib"
export YOLO_CONFIG_DIR="$GSR_RUNTIME_DIR/cache/ultralytics"
export HF_HOME="$GSR_RUNTIME_DIR/cache/huggingface"
export SAM_OBJECT_BATCH="${SAM_OBJECT_BATCH:-16}"
export SAM_MIN_DETECTION_IOU="${SAM_MIN_DETECTION_IOU:-0.1}"
export SAM_WINDOW_FRAMES="${SAM_WINDOW_FRAMES:-90}"
export SAM_WINDOW_OVERLAP="${SAM_WINDOW_OVERLAP:-15}"
export SAM_VOS_OPTIMIZED="${SAM_VOS_OPTIMIZED:-true}"
export SAM_PAD_COMPILED_BATCH="${SAM_PAD_COMPILED_BATCH:-true}"
export SAM_BIDIRECTIONAL="${SAM_BIDIRECTIONAL:-true}"
export SAM_PROMPTS_PER_TRACK="${SAM_PROMPTS_PER_TRACK:-3}"
export DETECTOR_TRACKER_FPS="${DETECTOR_TRACKER_FPS:-10}"
export REID_APPEARANCE_FPS="${REID_APPEARANCE_FPS:-5}"
export CALIBRATION_FPS="${CALIBRATION_FPS:-5}"
export GSR_CONCAT_TRACKLETS="${GSR_CONCAT_TRACKLETS:-false}"
export ROLE_MODEL_ENABLED="${ROLE_MODEL_ENABLED:-false}"
mkdir -p "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR" "$MPLCONFIGDIR" "$YOLO_CONFIG_DIR" "$HF_HOME"

conda run --no-capture-output -p "$RUNTIME_DIR/env" python -u -m worker.main "$JOB_DIR"
